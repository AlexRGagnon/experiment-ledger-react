{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist/node",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
